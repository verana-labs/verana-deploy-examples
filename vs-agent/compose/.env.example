# ---- identity and corporation -------------------------------------------------
# The corporation this agent acts for (its id on the registry, from the Frontend).
VERANA_CORPORATION_ID=
# BIP-39 mnemonic of the agent's own account. Generate it once, keep it secret, back it up.
VERANA_ACCOUNT_MNEMONIC=

# ---- network --------------------------------------------------------------------
VERANA_CHAIN_ID=vna-testnet-1
VERANA_RPC_ENDPOINT_URL=https://rpc.testnet.verana.network
VERANA_INDEXER_BASE_URL=https://idx.testnet.verana.network
# The ECS ecosystem you trust for identity credentials (see Environments and endpoints).
TRUSTED_ECS_ECOSYSTEM_DIDS=

# ---- the service --------------------------------------------------------------------
# Public origin of the agent. The DID is derived from it: choose it once.
PUBLIC_API_BASE_URL=https://agent.example.com
AGENT_PUBLIC_DID_METHOD=webvh
AGENT_MODE=standalone

# Claims of the ECS Service credential the agent issues to itself.
ECS_CLAIMS_SERVICE_NAME=My First Verifiable Service
ECS_CLAIMS_SERVICE_TYPE=WEB_PORTAL
ECS_CLAIMS_SERVICE_DESCRIPTION=A service made verifiable with VS Agent on the Verana testnet.
ECS_CLAIMS_SERVICE_MINIMUM_AGE_REQUIRED=0
# Placeholders served by the agent itself; replace with your own resources later.
ECS_CLAIMS_SERVICE_LOGO_URI=https://agent.example.com/vt/default/logo.svg
ECS_CLAIMS_SERVICE_TERMS_AND_CONDITIONS_URI=https://agent.example.com/vt/default/terms.html
ECS_CLAIMS_SERVICE_PRIVACY_POLICY_URI=https://agent.example.com/vt/default/privacy.html

# Claims the agent proposes for its ECS Organization credential (the validator may adjust them).
ECS_CLAIMS_ORG_NAME=Example Company Ltd
ECS_CLAIMS_ORG_LOGO_URI=https://agent.example.com/vt/default/logo.svg
ECS_CLAIMS_ORG_REGISTRY_ID=12345678
ECS_CLAIMS_ORG_ADDRESS=1 Example Street, Example City
ECS_CLAIMS_ORG_COUNTRY_CODE=CH

# ---- optional ---------------------------------------------------------------------
# EVENTS_WEBHOOK_URL=https://backend.example.com/vs-agent/events
# EVENTS_WEBHOOK_API_KEY=
# OID4VC_CONFIG_FILE_LOCATION=/config/openid4vc.json
AGENT_LOG_LEVEL=info
ADMIN_API_LOG_LEVEL=info

# ---- database ----------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
